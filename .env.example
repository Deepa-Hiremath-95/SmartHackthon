# BeltScanX AI Environment Configuration
PROJECT_NAME="BeltScanX AI"
ENVIRONMENT="development"
DEBUG=true

# Database: SQLite fallback for local development and testing
DATABASE_URL="sqlite:///./nexvion.db"

# Simulation configuration
SIM_SPEED_PRESET="600x"
SIM_TIME_ACCELERATION=600.0
SIM_RANDOM_SEED=42
SIM_HOLD_CRITICAL_LAPS=15
SIM_AUTO_LOOP=false
SIM_MAX_STORED_EVENTS=1000

# API and WebSocket
API_V1_PREFIX="/api/v1"
WS_PATH="/ws/live"
CORS_ORIGINS=["*"]
